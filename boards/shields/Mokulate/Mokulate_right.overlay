#include "Mokulate.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/battery_history_request.dtsi>

// Right half is the peripheral. Shift charlieplex passive index by 6 so the
// transform map in Mokulate.dtsi covers both sides in one 6x12 grid.
&default_transform {
    col-offset = <6>;
};

&xiao_serial { status = "disabled"; };

// PAW3222 Trackball Configuration
// Wiring: CS=GND, MOTION=P1.15, SDIO=P1.14, SCLK=P1.13 (v2.1)
// Wiring: CS=GND, MOTION=P0.29, SDIO=P0.03, SCLK=P0.28 (v2.0)
// Wiring: CS=GND, MOTION=P0.10, SDIO=P0.09, SCLK=P1.11 (prototype)
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,    /* P1.13 */
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,   /* P1.14 (SDIO: MOSI/MISO shorted) */
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;   /* P1.14 */
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };
};

&spi3 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";


    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        /* MOTION: P1.15 */
        irq-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

// Trackball input listener (central side - direct processing)
/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>, // XとYを入れ替える
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>; // 上下左右を合わせるためXを反転
    };
};

/ {
    chosen {
        zmk,battery = &non_lipo_battery;
    };

    // Disable default Xiao BLE battery monitoring (uses AIN7 with voltage divider)
    vbatt: vbatt {
        status = "disabled";
    };

    // Non-LiPo battery on AIN0 (D0/P0.02) - direct connection, no voltage divider
    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 0>;
    };
};
